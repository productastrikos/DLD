# Copied into /dist by Vite. Only Apache/LiteSpeed reads it — when the Node
# process serves the build itself (the normal deployment) it is inert, and
# Express applies the equivalent rules in server/index.js.
#
# It matters when a Hostinger shared-hosting account fronts the build with
# LiteSpeed: without the rewrite below, a deep link like /dld/dashboard is a
# 404 because only /index.html exists on disk.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite the API — it must reach Node, not the SPA shell.
  RewriteRule ^api/ - [L]

  # Anything that exists on disk is served as-is; everything else is a
  # client-side route and gets the SPA shell.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Only dist/assets/* carries a content hash in its filename, so only it may
  # be cached forever. The brand marks are copied verbatim from public/ and
  # keep their names; the shell must be revalidated on every load or a
  # redeploy never reaches a warm cache.
  SetEnvIf Request_URI "^/assets/" FINGERPRINTED=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=FINGERPRINTED

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
