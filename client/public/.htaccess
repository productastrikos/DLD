# Optional. The app does not need it.
#
# Routing lives in the URL hash, so every request a host sees is for /index.html
# or a real file under /assets — there is no deep link to rewrite and nothing
# here is load-bearing. What it does add, on Apache/LiteSpeed (Hostinger shared
# hosting), is compression, correct cache lifetimes and a few security headers.
#
# The rewrite below is kept only as a safety net for anyone who switches the app
# back to path-based routing.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Anything that exists on disk is served as-is; everything else is a
  # client-side route and gets the SPA shell.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Only dist/assets/* carries a content hash in its filename, so only it may
  # be cached forever. The brand marks are copied verbatim from public/ and
  # keep their names; the shell must be revalidated on every load or a
  # redeploy never reaches a warm cache.
  SetEnvIf Request_URI "^/assets/" FINGERPRINTED=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=FINGERPRINTED

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
