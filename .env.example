# Port the Node process listens on.
# Hostinger injects PORT for you — set it only when running the app yourself.
PORT=5061

# Interface to bind. 0.0.0.0 is required behind Hostinger's proxy / in Docker.
HOST=0.0.0.0

# Local development only: `npm run dev` runs the API here and Vite on :5174,
# proxying /api across. Ignored in production, where one process serves both.
API_PORT=5061
